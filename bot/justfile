# Lists all available commands
list:
    just --list

# Install node libraries
install:
    npm install

# Generate API client code
generate-api-client:
    npm run generate-api-client

# =======
# BOT (No docker)
# =======

# Starts the bot in development mode
dev:
    npm run dev < /dev/null

# Starts the bot
start:
    npm run start

# Deploys bot commands
deploy:
    npm run deploy-commands

# =======
# CHECKS
# =======

lint:
    npm run lint

typecheck:
    npm run typecheck
