{
  "name": "bot-template",
  "version": "0.0.0",
  "main": "index.ts",
  "author": "Mystievous",
  "license": "MIT",
  "scripts": {
    "start": "tsx --env-file-if-exists=envs/.env index.ts",
    "dev": "tsx watch --env-file-if-exists=envs/.env --clear-screen=false index.ts",
    "deploy-commands": "tsx --env-file-if-exists=envs/.env deploy-commands.ts",
    "generate-api-client": "orval",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "orval": "^8.48.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
