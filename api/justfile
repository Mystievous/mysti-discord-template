# Lists all available commands
list:
    just --list

# Installs python dependencies
install:
    uv sync

# =======
# API (No docker)
# =======

# Starts the API in development mode
dev:
    alembic upgrade head
    fastapi dev

# Starts the API
start:
    alembic upgrade head
    fastapi run

# Generates the OpenAPI schema file
generate-openapi:
    rm -f openapi.json || true
    python generate-openapi.py
    @echo "Generated ./api/openapi.json"

# Generates an API key
generate-api-key *purpose="bot":
    alembic upgrade head
    python generate-api-key.py "{{ purpose }}"

# =======
# DATABASE MIGRATIONS
# =======

# Creates a new Alembic migration revision (diff against temporary database)
revise *message:
    rm -f revise.db
    DATABASE_URI=sqlite:///revise.db alembic upgrade head
    DATABASE_URI=sqlite:///revise.db alembic revision --autogenerate -m "{{ message }}"
    rm -f revise.db

# Applies Alembic migrations in the Docker database (the stack must be running)
migrate:
    docker compose exec api alembic upgrade head

# Rolls back the last Alembic migration
rollback:
    docker compose exec api alembic downgrade -1
